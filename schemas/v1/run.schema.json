{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdr-beads.local/schemas/v1/run.schema.json",
  "title": "Bead-run v1 durable policy record (no adapter-private storage)",
  "$ref": "#/$defs/Run",
  "$defs": {
    "LocalRepository": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "commonDir": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        }
      },
      "required": [
        "root",
        "commonDir"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/LocalRepository"
        },
        "beadsDir": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "issueId": {
          "type": "string",
          "minLength": 1
        },
        "machineId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "beadsDir",
        "issueId",
        "machineId"
      ],
      "additionalProperties": false
    },
    "Fence": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "runId",
        "attempt",
        "generation"
      ],
      "additionalProperties": false
    },
    "Precondition": {
      "type": "object",
      "properties": {
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "fence",
        "revision"
      ],
      "additionalProperties": false
    },
    "GitHubRepository": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "host",
        "repositoryId",
        "owner",
        "name"
      ],
      "additionalProperties": false
    },
    "LocalTarget": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "local-target"
        },
        "repository": {
          "$ref": "#/$defs/LocalRepository"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/.+"
        }
      },
      "required": [
        "mode",
        "repository",
        "ref"
      ],
      "additionalProperties": false
    },
    "RemoteTarget": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "remote-target"
        },
        "repository": {
          "$ref": "#/$defs/LocalRepository"
        },
        "remoteUrl": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/.+"
        }
      },
      "required": [
        "mode",
        "repository",
        "remoteUrl",
        "ref"
      ],
      "additionalProperties": false
    },
    "PullRequestTarget": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "github-pr"
        },
        "repository": {
          "$ref": "#/$defs/GitHubRepository"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/.+"
        }
      },
      "required": [
        "mode",
        "repository",
        "ref"
      ],
      "additionalProperties": false
    },
    "Target": {
      "oneOf": [
        {
          "$ref": "#/$defs/LocalTarget"
        },
        {
          "$ref": "#/$defs/RemoteTarget"
        },
        {
          "$ref": "#/$defs/PullRequestTarget"
        }
      ]
    },
    "Workspace": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "omp-worktree"
        },
        "backing": {
          "enum": [
            "linked",
            "clone"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "branchRef": {
          "type": "string",
          "pattern": "^refs/heads/.+"
        },
        "sourceRepository": {
          "$ref": "#/$defs/LocalRepository"
        },
        "commonDir": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        }
      },
      "required": [
        "provider",
        "backing",
        "path",
        "branchRef",
        "sourceRepository",
        "commonDir"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "harness": {
          "const": "omp"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "bindingId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "harness",
        "sessionId",
        "bindingId"
      ],
      "additionalProperties": false
    },
    "Terminal": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "spaceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tabId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "machineId",
        "address",
        "spaceId",
        "tabId"
      ],
      "additionalProperties": false
    },
    "Execution": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "preparing",
            "starting",
            "running",
            "idle",
            "stopped",
            "failed",
            "released"
          ]
        },
        "access": {
          "enum": [
            "writable",
            "read_only"
          ]
        },
        "activity": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Terminal"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "readOnlyAcknowledged": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "access",
        "activity",
        "session",
        "terminal",
        "observedAt",
        "readOnlyAcknowledged"
      ],
      "additionalProperties": false
    },
    "SubmissionKey": {
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1
        },
        "submissionRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "submissionId",
        "submissionRevision"
      ],
      "additionalProperties": false
    },
    "SubmissionIdentity": {
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1
        },
        "submissionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "pullRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "number",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "submissionId",
        "submissionRevision",
        "head",
        "target",
        "pullRequest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "mode": {
                    "const": "github-pr"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "pullRequest": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "pullRequest": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "IntegrationReceipt": {
      "type": "object",
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionKey"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "target": {
          "$ref": "#/$defs/LocalTarget"
        },
        "resultCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "attestedBy": {
          "type": "string",
          "minLength": 1
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "receiptId",
        "fence",
        "submission",
        "head",
        "target",
        "resultCommit",
        "attestedBy",
        "attestedAt"
      ],
      "additionalProperties": false
    },
    "LocalEvidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionKey"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "targetCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "kind": {
          "const": "local-target"
        },
        "target": {
          "$ref": "#/$defs/LocalTarget"
        },
        "proof": {
          "enum": [
            "ancestry",
            "receipt"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evidenceId",
        "fence",
        "submission",
        "head",
        "observedAt",
        "targetCommit",
        "kind",
        "target",
        "proof",
        "receipt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "proof": {
                "const": "receipt"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "RemoteEvidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionKey"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "targetCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "kind": {
          "const": "remote-target"
        },
        "target": {
          "$ref": "#/$defs/RemoteTarget"
        },
        "authorityUrl": {
          "type": "string",
          "minLength": 1
        },
        "observedRemoteRef": {
          "type": "string",
          "pattern": "^refs/heads/.+"
        }
      },
      "required": [
        "evidenceId",
        "fence",
        "submission",
        "head",
        "observedAt",
        "targetCommit",
        "kind",
        "target",
        "authorityUrl",
        "observedRemoteRef"
      ],
      "additionalProperties": false
    },
    "PullRequestEvidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "submission": {
          "$ref": "#/$defs/SubmissionKey"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "targetCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "kind": {
          "const": "github-pr"
        },
        "target": {
          "$ref": "#/$defs/PullRequestTarget"
        },
        "pullRequest": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "number",
            "url"
          ],
          "additionalProperties": false
        },
        "mergedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mergedHead": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "mergeCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "providerRecordId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidenceId",
        "fence",
        "submission",
        "head",
        "observedAt",
        "targetCommit",
        "kind",
        "target",
        "pullRequest",
        "mergedAt",
        "mergedHead",
        "mergeCommit",
        "providerRecordId"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/LocalEvidence"
        },
        {
          "$ref": "#/$defs/RemoteEvidence"
        },
        {
          "$ref": "#/$defs/PullRequestEvidence"
        }
      ]
    },
    "Submission": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/SubmissionIdentity"
        },
        "state": {
          "enum": [
            "pending",
            "open",
            "changes_requested",
            "closed_unmerged",
            "head_changed",
            "integrated",
            "needs_confirmation",
            "unknown"
          ]
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "identity",
        "state",
        "observedAt",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "integrated"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/Evidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {
                "properties": {
                  "target": {
                    "properties": {
                      "mode": {
                        "const": "local-target"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LocalEvidence"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {
                "properties": {
                  "target": {
                    "properties": {
                      "mode": {
                        "const": "remote-target"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RemoteEvidence"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {
                "properties": {
                  "target": {
                    "properties": {
                      "mode": {
                        "const": "github-pr"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PullRequestEvidence"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "workspaceHead": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubmissionKey"
          },
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "unsubmitted",
            "pending",
            "partial",
            "integrated",
            "unknown"
          ]
        }
      },
      "required": [
        "revision",
        "workspaceHead",
        "required",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "integrated"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "minItems": 1
              },
              "workspaceHead": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "ReleaseReceipt": {
      "type": "object",
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ]
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        },
        "acknowledgedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "receiptId",
        "fence",
        "session",
        "releasedAt",
        "acknowledgedBy"
      ],
      "additionalProperties": false
    },
    "Release": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "held",
            "requested",
            "released"
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "receipt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "released"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "#/$defs/ReleaseReceipt"
              }
            }
          }
        }
      ]
    },
    "Closure": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "awaiting_manual",
            "observed_closed",
            "held"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "manualCommand": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": [
        "state",
        "evidenceIds",
        "observedAt",
        "reason",
        "manualCommand"
      ],
      "additionalProperties": false
    },
    "CleanupBlocker": {
      "enum": [
        "manual_cleanup_required",
        "not_integrated",
        "not_closed",
        "not_released",
        "owner_active",
        "owner_unknown",
        "read_only_unacknowledged",
        "dirty",
        "untracked",
        "ignored",
        "unpushed_or_unpreserved",
        "extra_commits",
        "workspace_mismatch",
        "registry_mismatch",
        "session_not_preserved",
        "foreign_machine",
        "stale_attempt",
        "issue_changed",
        "evidence_unavailable",
        "evidence_invalid",
        "operation_failed",
        "capability_unsupported"
      ]
    },
    "Cleanup": {
      "type": "object",
      "properties": {
        "state": {
          "const": "held"
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CleanupBlocker"
          },
          "uniqueItems": true
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "blockers",
        "checkedAt"
      ],
      "additionalProperties": false
    },
    "IssueObservation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "assignee": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "assignee",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "closeAfterIntegration": {
          "const": false
        },
        "cleanupAfterRelease": {
          "const": false
        }
      },
      "required": [
        "closeAfterIntegration",
        "cleanupAfterRelease"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "current",
            "superseded",
            "cancelled",
            "reassigned",
            "reopened"
          ]
        },
        "harness": {
          "const": "omp"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Workspace"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution": {
          "$ref": "#/$defs/Execution"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "submissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Submission"
          }
        },
        "release": {
          "$ref": "#/$defs/Release"
        },
        "closure": {
          "$ref": "#/$defs/Closure"
        },
        "cleanup": {
          "$ref": "#/$defs/Cleanup"
        },
        "issueObservation": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "fence",
        "revision",
        "scope",
        "owner",
        "disposition",
        "harness",
        "policy",
        "target",
        "workspace",
        "execution",
        "coverage",
        "submissions",
        "release",
        "closure",
        "cleanup",
        "issueObservation",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "state": {
                    "const": "released"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "release": {
                "properties": {
                  "state": {
                    "const": "released"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "state": {
                    "enum": [
                      "running",
                      "idle"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "execution": {
                "properties": {
                  "session": {
                    "$ref": "#/$defs/Session"
                  },
                  "terminal": {
                    "$ref": "#/$defs/Terminal"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "closure": {
                "properties": {
                  "state": {
                    "const": "observed_closed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "closure": {
                "properties": {
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "release": {
                "properties": {
                  "state": {
                    "const": "released"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "execution": {
                "properties": {
                  "state": {
                    "const": "released"
                  },
                  "activity": {
                    "const": "inactive"
                  },
                  "access": {
                    "const": "read_only"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "state": {
                    "const": "integrated"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "execution": {
                "properties": {
                  "access": {
                    "const": "read_only"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
